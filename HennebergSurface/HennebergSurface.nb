        RowBox[{"j", ",", "0", ",", "limit", ",", "limit"}], "}"}]}], "]"}], ",", 
     RowBox[{"PlotPoints", "->", "numPoints"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
