       RowBox[{
        RowBox[{"Tube", "[", 
         RowBox[{"radius", ",", 
          RowBox[{"PlotPoints", "->", "numPoints"}]}], "]"}], ",", 
        RowBox[{"RGBColor", "[", "\"\<#9a393a\>\"", "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corners", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sphere", "[", 
        RowBox[{
