      RowBox[{"Cos", "[", 
       RowBox[{"2", "v"}], "]"}], 
      RowBox[{"Cosh", "[", 
       RowBox[{"2", "u"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"width", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"limit", "=", 
   RowBox[{"6", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scale", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"radius", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numPoints", "=", "24"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gridStepsU", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gridStepsV", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"curvesU", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"scale", "*", 
      RowBox[{"f", "[", 
       RowBox[{"u", ",", "i"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "limit", ",", 
       RowBox[{"limit", "/", "gridStepsU"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"curvesV", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"scale", "*", 
      RowBox[{"f", "[", 
       RowBox[{"j", ",", "v"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"-", "width"}], ",", "width", ",", 
       RowBox[{"2", 
        RowBox[{"width", "/", "gridStepsV"}]}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tubesU", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{"curvesU", ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", 
       RowBox[{"-", "width"}], ",", "width"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tube", "[", 
         RowBox[{"radius", ",", 
          RowBox[{"PlotPoints", "->", "numPoints"}]}], "]"}], ",", "Green"}], 
       "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tubesV", "=", 
