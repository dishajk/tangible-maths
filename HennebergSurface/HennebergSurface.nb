     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tube", "[", 
         RowBox[{"radius", ",", 
          RowBox[{"PlotPoints", "->", "numPoints"}]}], "]"}], ",", "Green"}], 
       "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tubesV", "=", 
