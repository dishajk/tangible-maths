         RowBox[{"2", "width"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "limit", ",", "limit"}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"PlotPoints", "->", "numPoints"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
