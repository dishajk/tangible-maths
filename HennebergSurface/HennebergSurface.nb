     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corners", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sphere", "[", 
