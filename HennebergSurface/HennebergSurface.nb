Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"2", 
       RowBox[{"Cos", "[", "v", "]"}], 
       RowBox[{"Sinh", "[", "u", "]"}]}], "-", 
      RowBox[{
       FractionBox["2", "3"], 
       RowBox[{"Cos", "[", 
        RowBox[{"3", "v"}], "]"}], 
       RowBox[{"Sinh", "[", 
        RowBox[{"3", "u"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"2", 
       RowBox[{"Sin", "[", "v", "]"}], 
       RowBox[{"Sinh", "[", "u", "]"}]}], "+", 
      RowBox[{
       FractionBox["2", "3"], 
       RowBox[{"Sin", "[", 
        RowBox[{"3", "v"}], "]"}], 
       RowBox[{"Sinh", "[", 
        RowBox[{"3", "u"}], "]"}]}]}], ",", 
