Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Step"}]}], " ", "1"}], ":", 
    RowBox[{
     RowBox[{"Regenerate", " ", "Hani", " ", "Pattern", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Same", " ", "as", " ", "before"}], ")"}], "--"}]}], "-"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"angle", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"90", "-", "64.2086"}], ")"}], " ", "Degree"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"pts", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dirs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RotationTransform", "[", "angle", "]"}], "[", "v", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solve", " ", "intersections"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intersections", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"pts", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", 
            RowBox[{"s", " ", 
             RowBox[{"dirs", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "==", 
           RowBox[{
            RowBox[{"pts", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"i", ",", "4"}], "]"}], "+", "1"}], "]"}], "]"}], "+", 
            RowBox[{"t", " ", 
             RowBox[{"dirs", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{"i", ",", "4"}], "]"}], "+", "1"}], "]"}], 
              "]"}]}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "t"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intersectionPts", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"pts", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "+", 
         RowBox[{"s", " ", 
          RowBox[{"dirs", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "/.", " ", 
        RowBox[{"intersections", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h", "=", "0.03"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Connector", " ", "width"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"intersectionPts", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"pts", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Normalize", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{"d", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"connectorRectangles", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Polygon", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pts", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"pts", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", 
            RowBox[{"h", " ", 
             RowBox[{"n", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"intersectionPts", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", 
            RowBox[{"h", " ", 
             RowBox[{"n", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
           RowBox[{"intersectionPts", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"boundary", "=", 
     RowBox[{"RegionDifference", "[", 
      RowBox[{
       RowBox[{"Polygon", "[", 
        RowBox[{"7", "pts"}], "]"}], ",", 
       RowBox[{"Polygon", "[", "pts", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"darkArea", "=", 
     RowBox[{"RegionUnion", "[", 
      RowBox[{
       RowBox[{"RegionUnion", "[", 
        RowBox[{
         RowBox[{"RegionUnion", "[", "connectorRectangles", "]"}], ",", 
         RowBox[{"Polygon", "[", "intersectionPts", "]"}]}], "]"}], ",", 
       "boundary"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{"Discretize", " ", "the", " ", "2", "D", " ", 
       RowBox[{"Pattern", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Create", " ", "a", " ", "high"}], "-", 
     RowBox[{"quality", " ", "2", "D", " ", "mesh"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mesh2D", "=", 
     RowBox[{"DiscretizeRegion", "[", 
      RowBox[{"darkArea", ",", 
       RowBox[{"MaxCellMeasure", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Area\>\"", "->", "0.0005"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "raw", " ", 
     RowBox[{"data", ":", 
      RowBox[{"vertices", " ", "and", " ", "triangle", " ", "indices"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coords2D", "=", 
     RowBox[{"MeshCoordinates", "[", "mesh2D", "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"List", " ", "of", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"triIndices", "=", 
     RowBox[{
      RowBox[{"MeshCells", "[", 
       RowBox[{"mesh2D", ",", "2"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"List", " ", "of", " ", 
     RowBox[{"{", 
      RowBox[{"i1", ",", "i2", ",", "i3"}], "}"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "Step"}]}], " ", "3"}], ":", 
        RowBox[{"Vectorized", " ", "Projection"}]}], "&"}], " ", 
      RowBox[{"Extrusion", "--"}]}], "-"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3", 
      RowBox[{"a", ".", "Projection"}], " ", 
      RowBox[{"Function", ":", 
       RowBox[{"Plane", " ", 
        RowBox[{"(", 
         RowBox[{"z", "=", 
          RowBox[{"-", "1"}]}], ")"}]}]}]}], "->", 
     RowBox[{"Unit", " ", "Sphere"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Maps", " ", "a", " ", "list", " ", "of", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], " ", "points", " ", "to", " ", 
     RowBox[{"{", 
      RowBox[{"X", ",", "Y", ",", "Z"}], "}"}], " ", "on", " ", "the", " ", 
     "sphere"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"projectToSphere", "[", "pts_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "d2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{"pts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"y", "=", 
         RowBox[{"pts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d2", "=", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}], "+", "4"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"4", " ", 
            RowBox[{"x", "/", "d2"}]}], ",", 
           RowBox[{"4", " ", 
            RowBox[{"y", "/", "d2"}]}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "^", "2"}], "+", 
              RowBox[{"y", "^", "2"}], "-", "4"}], ")"}], "/", "d2"}]}], 
          "}"}], "]"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3", 
     RowBox[{"b", ".", "Generate"}], " ", "3", "D", " ", "Vertices"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"baseVerticesSphere", "=", 
     RowBox[{"projectToSphere", "[", "coords2D", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"shellThickness", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "Inner", " ", "and", " ", "Outer", " ", "shells", " ", 
