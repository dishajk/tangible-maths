     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Indices", " ", "N"}], "+", "1"}], ".."}], "2", "N", " ", 
      "are", " ", "Outer"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"allVertices3D", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"verticesInner", ",", "verticesOuter"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numVerts", "=", 
     RowBox[{"Length", "[", "verticesInner", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3", 
     RowBox[{"c", ".", "Generate"}], " ", "Prism", " ", "Indices"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"If", " ", "a", " ", "triangle", " ", "uses", " ", "indices", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], ",", 
     RowBox[{"the", " ", "prism", " ", "uses", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", "b", ",", "c", ",", 
        RowBox[{"a", "+", "N"}], ",", 
        RowBox[{"b", "+", "N"}], ",", 
        RowBox[{"c", "+", "N"}]}], "}"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"prismIndices", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"tri", ",", 
         RowBox[{"tri", "+", "numVerts"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"tri", ",", "triIndices"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "4"}], ":", 
     RowBox[{
      RowBox[{"Create", " ", "the", " ", "Final", " ", 
       RowBox[{"MeshRegion", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Using", " ", 
      RowBox[{"Prism", "[", "]"}], " ", "which", " ", "correctly", " ", 
      "handles", " ", "6"}], "-", 
     RowBox[{"point", " ", "triangular", " ", "wedges"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Bhaskara3D", "=", 
