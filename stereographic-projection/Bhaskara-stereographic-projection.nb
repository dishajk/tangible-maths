   RowBox[{
    RowBox[{"verticesInner", "=", 
     RowBox[{"baseVerticesSphere", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"shellThickness", "/", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"verticesOuter", "=", 
     RowBox[{"baseVerticesSphere", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"shellThickness", "/", "2"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
